# Copy to .env and provide a unique password and session secret.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_URL=http://localhost:3000
FEYLORE_PORT=3000
# Optional: override the database connection for an external PostgreSQL server.
# DATABASE_URL=postgresql://user:password@host:5432/feylore

# Optional host directory overrides. Bind mounts must be accessible to UID 1000.
# BOOKS_PATH=./library/books
# AUDIOBOOKS_PATH=./library/audiobooks
# PODCASTS_PATH=./library/podcasts
# MUSIC_PATH=./library/music
# MOVIES_PATH=./library/movies
# TV_PATH=./library/tv
# TTRPG_PATH=./library/ttrpg
# INGEST_PATH=./ingest
