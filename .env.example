# Database
DATABASE_URL=postgresql://feylore:feylore@localhost:5432/feylore
# Production Compose also requires POSTGRES_PASSWORD and a DATABASE_URL whose
# hostname is postgres. URL-encode special characters in the password.
# POSTGRES_PASSWORD=
# FEYLORE_IMAGE=ghcr.io/feylore-media/feylore:latest
# FEYLORE_PORT=3000
# MEDIA_ROOT=/absolute/path/to/media

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173

# Security (generate a strong secret for production)
SESSION_SECRET=dev-session-secret-change-in-production

# Storage (server-only; never expose to clients)
STORAGE_ROOT=./data/storage
INGEST_ROOT=./ingest
LIBRARY_BOOKS_ROOT=./library/books
MAX_UPLOAD_BYTES=524288000
MAX_UPLOAD_FILES=20

# Optional SMTP for password reset
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Authentication
AUTH_INTERNAL_ENABLED=true
AUTH_OIDC_ENABLED=false
AUTH_INTERNAL_RECOVERY_ENABLED=true

# OIDC (required when AUTH_OIDC_ENABLED=true)
# OIDC_ISSUER_URL=https://auth.example.com/realms/feylore
# OIDC_CLIENT_ID=feylore
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid,profile,email
# OIDC_AUTO_PROVISION=false
# OIDC_ALLOW_PRIVATE_ISSUER=false
# OIDC_LABEL=Your identity provider
