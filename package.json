{
  "name": "feylore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:worker": "tsx watch src/server/worker.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "worker": "node dist/server/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@readium/css": "^2.0.5",
    "@readium/navigator": "^2.8.2",
    "@readium/navigator-html-injectables": "^2.6.3",
    "@readium/shared": "^2.4.0",
    "@solar-icons/react": "^2.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "hls.js": "^1.7.1",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "jszip": "^3.10.1",
    "music-metadata": "^11.15.0",
    "nodemailer": "^9.0.6",
    "openid-client": "^6.8.7",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.4.1",
    "react-router": "^8.3.0",
    "rss-parser": "^3.13.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jose": "^6.2.10",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.7"
  }
}
